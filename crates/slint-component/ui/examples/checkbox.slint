import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Checkbox } from "../checkbox.slint";
import { ControlSize } from "../theme.slint";

export component CheckboxExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    private property <bool> updates: false;
    private property <bool> terms: false;
    private property <bool> newsletter: true;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Accept terms and conditions";
            checked: true;
        }
        Checkbox {
            label: "Receive product updates";
            description: "Occasional emails about new releases.";
        }
        Checkbox {
            label: "Indeterminate";
            indeterminate: true;
        }
        Checkbox {
            label: "Disabled";
            enabled: false;
        }
    }
    GroupBox {
        title: "Default";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Product updates";
        }
        Checkbox {
            label: "Remember this device";
            checked: true;
        }
    }
    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            Checkbox {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                label: "XS";
                size: ControlSize.xsmall;
                checked: true;
            }
            Checkbox {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                label: "SM";
                size: ControlSize.small;
                checked: true;
            }
            Checkbox {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                label: "MD";
                checked: true;
            }
            Checkbox {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                label: "LG";
                size: ControlSize.large;
                checked: true;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }
    GroupBox {
        title: "Controlled Checkbox";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Receive product updates";
            checked <=> root.updates;
        }
        Text {
            text: root.updates ? "Subscribed" : "Not subscribed";
            color: Theme.muted-foreground;
            font-size: Theme.font-size-xs;
        }
    }
    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Checked";
            checked: true;
            enabled: false;
        }
        Checkbox {
            label: "Unchecked";
            enabled: false;
        }
    }
    GroupBox {
        title: "Without label";
        variant: GroupBoxVariant.outline;
        Checkbox {
            checked: true;
        }
    }
    GroupBox {
        title: "Labels";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Automatic updates";
            description: "Download updates when the application is idle.";
            checked: true;
        }
        Checkbox {
            label: "Notify me when a new device signs in to my account";
        }
        Checkbox {
            label: "Accept the terms";
            description: "Read the terms of service before continuing.";
        }
    }
    GroupBox {
        title: "Checkbox List";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "Option 1";
            checked: true;
        }
        Checkbox {
            label: "Option 2";
        }
        Checkbox {
            label: "Option 3";
        }
    }
    GroupBox {
        title: "Form Integration";
        variant: GroupBoxVariant.outline;
        Checkbox {
            label: "I agree to the terms and conditions";
            checked <=> root.terms;
        }
        Checkbox {
            label: "Subscribe to newsletter";
            checked <=> root.newsletter;
        }
    }
}
