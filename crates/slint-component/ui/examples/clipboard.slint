import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Clipboard } from "../clipboard.slint";
import { Input } from "../input.slint";

export component ClipboardExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Copy";
        variant: GroupBoxVariant.outline;
        // Stretch fills the card. A grid cell with stretch 0 collapses this
        // field, because its preferred width is the parent's width.
        field := Input {
            min-width: 280px;
            text: "https://github.com";
            Clipboard {
                value: field.text;
            }
        }
    }
}
