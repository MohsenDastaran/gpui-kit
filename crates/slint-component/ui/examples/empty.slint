import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Empty } from "../empty.slint";

export component EmptyExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    Empty {
        icon: "inbox";
        title: "No messages";
        description: "When someone writes to you, it will show up here.";
        action: "Compose";
    }

}
