import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Message, MessageRole } from "../message.slint";

export component MessageExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    Message { role: MessageRole.user; body: "How do I add a Slint button?"; }
    Message { role: MessageRole.assistant; body: "Copy button.slint and theme.slint into your project, then import Button."; }

}
