// Gallery-only. The example title and its code icon share one row. Either one
// tells the embedding page which sample to show. Installed components do not
// include this file.

import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";

export global ExampleBridge {
    in-out property <int> next-id: 0;
    callback show(int, string);
}

export component SourceHeading inherits HorizontalLayout {
    in property <string> title;
    in property <color> color: Theme.muted-foreground;
    in property <length> font-size: Theme.font-size-sm;
    in property <int> font-weight: 500;

    property <int> index: -1;

    spacing: 4px;
    vertical-stretch: 0;

    init => {
        root.index = ExampleBridge.next-id;
        ExampleBridge.next-id += 1;
    }

    function open() {
        if root.title == "" || root.index < 0 {
            return;
        }
        ExampleBridge.show(root.index, root.title);
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        title-hit := TouchArea {
            clicked => { root.open(); }

            Text {
                text: root.title;
                color: root.color;
                font-size: root.font-size;
                font-weight: root.font-weight;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    VerticalLayout {
        alignment: center;

        icon := Rectangle {
            width: 24px;
            height: 24px;
            vertical-stretch: 0;
            border-radius: Theme.radius-sm;
            background: icon-hit.has-hover ? Theme.accent : transparent;
            accessible-role: button;
            accessible-label: "View source";
            accessible-action-default => { root.open(); }

            icon-hit := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.open(); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    name: "code-xml";
                    size: 14px;
                    color: Theme.muted-foreground;
                }
            }
        }
    }
}
