// Gallery-only. A code button on each example tells the embedding page which
// sample to show. Installed components do not include this file.

import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";

export global ExampleBridge {
    in-out property <int> next-id: 0;
    callback show(int, string);
}

export component SourceButton inherits Rectangle {
    in property <string> title;
    property <int> index: -1;

    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.accent : transparent;
    accessible-role: button;
    accessible-label: "View source";
    accessible-action-default => { root.open(); }

    init => {
        root.index = ExampleBridge.next-id;
        ExampleBridge.next-id += 1;
    }

    function open() {
        if root.title == "" || root.index < 0 {
            return;
        }
        ExampleBridge.show(root.index, root.title);
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.open(); }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "code-xml";
            size: 14px;
            color: Theme.muted-foreground;
        }
    }
}
