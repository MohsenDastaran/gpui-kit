import { Theme, ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";

export component GroupBoxExample inherits VerticalLayout {
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        Text { text: "Content without a visual container"; color: Theme.foreground; }
    }

    GroupBox {
        title: "Account Settings";
        variant: GroupBoxVariant.fill;
        GridLayout {
            Text {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Make profile private"; color: Theme.foreground; vertical-alignment: center; }
            Rectangle {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                 }
            Button {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Private"; }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
        HorizontalLayout {
            alignment: start;
            Button { text: "Save Changes"; variant: ButtonVariant.primary; }
        }
    }

    GroupBox {
        title: "Preferences";
        variant: GroupBoxVariant.outline;
        Text { text: "Content with a border and no background."; color: Theme.foreground; }
    }
}
