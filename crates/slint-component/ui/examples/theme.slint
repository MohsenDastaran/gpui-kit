import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Button } from "../button.slint";

export component ThemeExample inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    GroupBox { title: "Palette"; variant: GroupBoxVariant.outline;
        Button { text: Theme.dark ? "Switch to light" : "Switch to dark"; clicked => { Theme.dark = !Theme.dark; } }
        HorizontalLayout { spacing: 8px;
            Rectangle { width: 32px; height: 32px; border-radius: 6px; background: Theme.primary; }
            Rectangle { width: 32px; height: 32px; border-radius: 6px; background: Theme.secondary; }
            Rectangle { width: 32px; height: 32px; border-radius: 6px; background: Theme.danger; }
            Rectangle { width: 32px; height: 32px; border-radius: 6px; background: Theme.success; }
        }
    }

}
