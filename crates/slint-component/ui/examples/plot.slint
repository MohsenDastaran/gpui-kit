import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Plot } from "../plot.slint";

export component PlotExample inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    Plot {
        height: 220px;
        x-label: "Day";
        y-label: "Requests";
        points: [
            { label: "Mon", value: 40 },
            { label: "Tue", value: 70 },
            { label: "Wed", value: 55 },
        ];
    }

}
