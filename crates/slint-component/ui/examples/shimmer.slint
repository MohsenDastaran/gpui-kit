import { Theme } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Icon } from "../icon.slint";
import { ShimmerText } from "../shimmer.slint";

export component ShimmerExample inherits VerticalLayout {
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    in-out property <bool> generating: true;

    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 32px;            ShimmerText {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Thinking…"; }
            ShimmerText {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Generating a response…"; color: Theme.muted-foreground; }
            ShimmerText {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Loading project data…"; font-size: Theme.font-size-md; font-weight: 500; }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
    }

    GroupBox {
        title: "Timing, spread and color";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 32px;            ShimmerText {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Indexing files…"; duration: 3s; highlight-color: Theme.primary; color: Theme.muted-foreground; spread: 0.45; reverse: true; }
            ShimmerText {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Loading a narrow label…"; color: Theme.muted-foreground; spread: 0.15; }
            ShimmerText {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Loading a broad label…"; color: Theme.muted-foreground; spread: 0.7; }
            ShimmerText {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                 text: "Fixed-width highlight…"; color: Theme.muted-foreground; spread-width: 48px; }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
    }

    GroupBox {
        title: "Play once";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 16px;            finalizing := ShimmerText {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Finalizing…";
                color: Theme.muted-foreground;
                reverse: true;
                once: true;
                duration: 1.5s;
                vertical-stretch: 0;
            }
            Button {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                text: "Replay";
                icon: "refresh-cw";
                clicked => {
                    finalizing.restart();
                }
            }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
    }

    GroupBox {
        title: "In context";
        variant: GroupBoxVariant.outline;
        GridLayout {
            spacing: 12px;            Rectangle {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: Theme.muted;
                Icon { name: "bot"; color: Theme.muted-foreground; }
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                if root.generating: ShimmerText {
                    text: "The assistant is thinking…";
                    color: Theme.muted-foreground;
                }
                if !root.generating: Text {
                    text: "Here is a summary of the three open issues in the release milestone.";
                    color: Theme.foreground;
                    font-size: Theme.font-size-sm;
                }
            }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
        GridLayout {
            spacing: 12px;            Rectangle {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                width: 260px;
                height: 52px;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-lg;
                GridLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                        alignment: center;
                        Icon { name: "file-text"; color: Theme.muted-foreground; }
                    }
                    VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                        alignment: center;
                        spacing: 2px;
                        if root.generating: ShimmerText { text: "transcript.pdf"; font-weight: 500; }
                        if !root.generating: Text { text: "transcript.pdf"; color: Theme.foreground; font-size: Theme.font-size-sm; font-weight: 500; }
                        Text {
                            text: root.generating ? "Processing document…" : "PDF · 2.4 MB";
                            color: Theme.muted-foreground;
                            font-size: Theme.font-size-xs;
                        }
                    }
                
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                alignment: center;
                Button {
                    text: root.generating ? "Finish" : "Generate again";
                    clicked => {
                        root.generating = !root.generating;
                    }
                }
            }
        
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
}
    }
}
