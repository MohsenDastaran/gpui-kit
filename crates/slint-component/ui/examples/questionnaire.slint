import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Questionnaire } from "../questionnaire.slint";

export component QuestionnaireExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    Questionnaire {
        questions: [
            { prompt: "How often do you ship?", options: ["Daily", "Weekly", "Monthly"] },
            { prompt: "Primary toolkit?", options: ["GPUI", "Slint", "Other"] },
        ];
    }

}
