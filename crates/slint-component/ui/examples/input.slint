import { Theme, ButtonVariant, ControlSize } from "../theme.slint";
import { Button } from "../button.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Input } from "../input.slint";

export component InputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.field-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Basic";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            name := Input {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 1;
                placeholder: "Enter your name...";
            }
            Input {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 1;
                text: "John Doe";
            }
        }
        Text {
            text: name.text == "" ? "Type to see the value." : "Hello, \{name.text}!";
            color: Theme.muted-foreground;
        }
    }

    GroupBox {
        title: "Prefix, suffix and clear button";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Input {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 1;
                placeholder: "Search...";
                prefix-icon: "search";
                cleanable: true;
            }
            Input {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 1;
                placeholder: "Username";
                prefix-icon: "user";
                Button {
                    icon: "info";
                    variant: ButtonVariant.ghost;
                    size: ControlSize.xsmall;
                    accessible-label: "About usernames";
                }
            }
            Input {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 1;
                text: "1,280.00";
                prefix-text: "$";
                suffix-text: "USD";
                horizontal-alignment: TextHorizontalAlignment.right;
            }
        }
    }

    GroupBox {
        title: "Password";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Input {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 1;
                text: "password123";
                prefix-icon: "lock";
                masked: true;
                mask-toggle: true;
            }
            Input {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 1;
                placeholder: "Clears on Escape";
                text: "Press Escape";
                clean-on-escape: true;
            }
        }
    }

    GroupBox {
        title: "Sizes";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            VerticalLayout {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 1;
                alignment: center;
                Input {
                    placeholder: "Large";
                    size: ControlSize.large;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 1;
                alignment: center;
                Input {
                    placeholder: "Medium";
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 1;
                alignment: center;
                Input {
                    placeholder: "Small";
                    size: ControlSize.small;
                }
            }
            VerticalLayout {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 1;
                alignment: center;
                Input {
                    placeholder: "Extra small";
                    size: ControlSize.xsmall;
                }
            }
        }
    }

    GroupBox {
        title: "States";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Input {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 1;
                text: "Disabled";
                enabled: false;
            }
            Input {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 1;
                text: "Read-only, still selectable";
                read-only: true;
            }
            Input {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 1;
                text: "not-an-email";
                invalid: true;
            }
        }
    }
}
