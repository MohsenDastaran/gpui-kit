import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { DescriptionList, DescriptionLayout } from "../description-list.slint";

export component DescriptionListExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    DescriptionList {
        bordered: true;
        items: [
            { term: "Name", detail: "Ada Lovelace" },
            { term: "Role", detail: "Mathematician" },
            { term: "Born", detail: "1815" },
        ];
    }

}
