import { Theme } from "../theme.slint";
import { GroupBox } from "section.slint";
import { Avatar, AvatarGroup, AvatarSize } from "../avatar.slint";

export component AvatarExample inherits VerticalLayout {
    horizontal-stretch: 1;
    max-width: 680px;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    property <image> portrait: @image-url("assets/avatar-sample.svg");

    GroupBox {
        title: "Image";
        VerticalLayout {
            spacing: 12px;
            alignment: start;
            Avatar {
                source: root.portrait;
                initials: "JL";
            }
            Avatar {
                source: root.portrait;
            }
        }
    }

    GroupBox {
        title: "Fallback";
        VerticalLayout {
            spacing: 12px;
            alignment: start;
            Avatar { initials: "JL"; }
            Avatar { }
            Avatar { icon: "box"; }
        }
    }

    GroupBox {
        title: "Group";
        VerticalLayout {
            spacing: 20px;
            alignment: start;
            AvatarGroup {
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
            }
            AvatarGroup {
                limit: 5;
                ellipsis: true;
                overflow-count: 11;
                avatar-size: AvatarSize.medium;
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
                Avatar { source: root.portrait; horizontal-stretch: 0; }
            }
        }
    }

    GroupBox {
        title: "Custom shape";
        Avatar {
            source: root.portrait;
            custom-edge: 100px;
            radius: 20px;
        }
    }

    GroupBox {
        title: "Custom style";
        Avatar {
            source: root.portrait;
            custom-edge: 100px;
            border-width: 3px;
            border-color: Theme.foreground;
            shadow-blur: 4px;
            shadow-offset-y: 2px;
            shadow-color: Theme.shadow;
        }
    }
}
