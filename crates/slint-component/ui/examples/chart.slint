import { Theme } from "../theme.slint";
import { SourceButton } from "bridge.slint";
import {
    LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart,
    ChartLegend, LineInterpolation, BarAlign,
    ChartPoint, SeriesPoint, StackPoint, RadarPoint, CandlePoint, SankeyNode, SankeyLink,
} from "../chart.slint";

component ChartCard inherits Rectangle {
    in property <string> title;
    in property <string> period;
    in property <string> headline;
    in property <string> note;

    horizontal-stretch: 1;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.foreground;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            SourceButton { title: root.title; vertical-stretch: 0; }
        }
        if root.period != "": Text { text: root.period; color: Theme.muted-foreground; font-size: Theme.font-size-sm; }
        @children
        if root.headline != "": Text { text: root.headline; color: Theme.foreground; font-size: Theme.font-size-sm; wrap: word-wrap; }
        if root.note != "": Text { text: root.note; color: Theme.muted-foreground; font-size: Theme.font-size-xs; wrap: word-wrap; }
    }
}

component Rule inherits Rectangle {
    height: 1px;
    horizontal-stretch: 1;
    background: Theme.border;
}

