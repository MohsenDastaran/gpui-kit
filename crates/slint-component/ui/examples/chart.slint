        headline: "Trending up by 12.5% this month";
        note: "Straight segments between months";
        LineChart { points: conversion; interpolation: LineInterpolation.linear; stroke: Theme.chart-2; }
    }
    ChartCard {
        title: "Active Subscriptions";
        period: "2025";
        headline: "Trending up by 8.8% this month";
        note: "Step after: the value holds until the next month";
        LineChart { points: months; interpolation: LineInterpolation.step; stroke: Theme.chart-3; }
    }
    ChartCard {
        title: "Deploys";
        period: "Per month, 2025";
        headline: "Trending up by 19.2% this month";
        note: "A dot on every month";
