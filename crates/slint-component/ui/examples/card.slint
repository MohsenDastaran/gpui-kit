import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Card, CardFooter } from "../card.slint";
import { ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";

export component CardExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Default";
        Card {
            title: "Team";
            description: "Invite members and set their roles.";
            Text { text: "Twelve seats remaining on this workspace."; color: Theme.muted-foreground; }
            CardFooter {
                Button { text: "Cancel"; }
                Button { text: "Invite"; variant: ButtonVariant.primary; }
            }
        }
    }

    GroupBox {
        title: "Stacked";
        HorizontalLayout {
            spacing: 16px;
            Card {
                title: "Usage";
                Text { text: "4.2 GB of 10 GB used."; color: Theme.muted-foreground; }
            }
            Card {
                title: "Plan";
                Text { text: "Team · billed monthly."; color: Theme.muted-foreground; }
            }
        }
    }

}
