import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Carousel } from "../carousel.slint";

export component CarouselExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    Carousel {
        height: 200px;
        slides: [
            { title: "Welcome", body: "A desktop component gallery." },
            { title: "Copy", body: "Take the .slint files you need." },
            { title: "Theme", body: "Everything reads Theme tokens." },
        ];
    }

}
