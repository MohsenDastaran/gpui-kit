import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Sheet } from "../sheet.slint";
import { Button } from "../button.slint";

export component SheetExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <bool> open: true;
    Rectangle {
        width: 100%; height: Theme.viewport < 480px ? 280px : 360px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-lg; clip: true;
        Button { x: 16px; y: 16px; text: "Open sheet"; clicked => { root.open = true; } }
        Sheet {
            width: 100%; height: 100%;
            open <=> root.open;
            title: "Filters";
            description: "Narrow the results.";
        }
    }

}
