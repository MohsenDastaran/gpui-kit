import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Dialog, DialogFooter } from "../dialog.slint";
import { ButtonVariant } from "../theme.slint";
import { Button } from "../button.slint";

export component DialogExample inherits VerticalLayout {
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <bool> open: true;
    Rectangle {
        height: 360px; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-lg; clip: true;
        Button { x: 16px; y: 16px; text: "Open"; clicked => { root.open = true; } }
        Dialog {
            width: 100%; height: 100%;
            open <=> root.open;
            title: "Edit profile";
            description: "Make changes to your profile here.";
            DialogFooter {
                Button { text: "Cancel"; clicked => { root.open = false; } }
                Button { text: "Save"; variant: ButtonVariant.primary; clicked => { root.open = false; } }
            }
        }
    }

}
