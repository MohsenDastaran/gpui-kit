import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { MessageScroller, ChatTurn } from "../message-scroller.slint";
import { MessageRole } from "../message.slint";

export component MessageScrollerExample inherits VerticalLayout {
    padding: 24px;
    spacing: 24px;
    alignment: start;

    MessageScroller {
        height: 240px;
        messages: [
            { role: MessageRole.user, body: "Hello" },
            { role: MessageRole.assistant, body: "Hi — how can I help?" },
        ];
    }

}
