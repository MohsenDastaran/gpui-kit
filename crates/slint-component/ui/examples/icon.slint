import { Theme, ButtonVariant } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Icon } from "../icon.slint";
import { Button } from "../button.slint";

export component IconExample inherits VerticalLayout {
    horizontal-stretch: 1;
    private property <int> wrap-cols: Theme.wrap-columns(Theme.viewport);
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Icons";
        variant: GroupBoxVariant.outline;
        GridLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Icon {
                row: Theme.wrap-row(0, root.wrap-cols);
                col: Theme.wrap-col(0, root.wrap-cols);
                horizontal-stretch: 0;
                name: "search";
            }
            Icon {
                row: Theme.wrap-row(1, root.wrap-cols);
                col: Theme.wrap-col(1, root.wrap-cols);
                horizontal-stretch: 0;
                name: "settings";
            }
            Icon {
                row: Theme.wrap-row(2, root.wrap-cols);
                col: Theme.wrap-col(2, root.wrap-cols);
                horizontal-stretch: 0;
                name: "star";
                color: Theme.warning;
            }
            Icon {
                row: Theme.wrap-row(3, root.wrap-cols);
                col: Theme.wrap-col(3, root.wrap-cols);
                horizontal-stretch: 0;
                name: "loader-circle";
                spinning: true;
            }
            Rectangle {
                row: 0;
                col: root.wrap-cols;
                horizontal-stretch: 1;
            }
        }
    }

    GroupBox {
        title: "Icon with Custom Size";
        variant: GroupBoxVariant.outline;
        Icon {
            name: "search";
            size: 16px;
        }
        Icon {
            name: "search";
            size: 24px;
        }
        Icon {
            name: "search";
            size: 32px;
        }
    }

    GroupBox {
        title: "Status Icons";
        variant: GroupBoxVariant.outline;
        Icon {
            name: "circle-check";
            color: Theme.success;
        }
        Icon {
            name: "triangle-alert";
            color: Theme.warning;
        }
        Icon {
            name: "circle-x";
            color: Theme.danger;
        }
    }

    GroupBox {
        title: "Icon in Button";
        variant: GroupBoxVariant.outline;
        Button {
            text: "Search";
            icon: "search";
        }
        Button {
            icon: "settings";
            variant: ButtonVariant.ghost;
        }
    }

}
