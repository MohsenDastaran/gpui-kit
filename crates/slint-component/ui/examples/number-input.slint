import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { NumberInput } from "../number-input.slint";

export component NumberInputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Quantity";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 3;
            minimum: 0;
            maximum: 99;
            step: 1;
        }
        NumberInput {
            value: 19.99;
            prefix: "$";
            step: 0.5;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 4;
            size: ControlSize.small;
        }
        NumberInput {
            value: 4;
        }
        NumberInput {
            value: 4;
            size: ControlSize.large;
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        NumberInput {
            value: 8;
            enabled: false;
        }
    }

}
