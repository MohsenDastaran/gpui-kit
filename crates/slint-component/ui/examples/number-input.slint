import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { NumberInput } from "../number-input.slint";

export component NumberInputExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox { title: "Quantity"; variant: GroupBoxVariant.outline;
        NumberInput { value: 3; minimum: 0; maximum: 99; step: 1; }
        NumberInput { value: 19.99; prefix: "$"; step: 0.5; }
    }

}
