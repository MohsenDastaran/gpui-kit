import { Theme } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "../group-box.slint";
import { Radio, RadioGroup } from "../radio.slint";

export component RadioExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox { title: "Group"; variant: GroupBoxVariant.outline;
        RadioGroup { options: ["Email", "SMS", "Push"]; selected: 0; }
    }
    GroupBox { title: "Standalone"; variant: GroupBoxVariant.outline;
        Radio { label: "Disabled"; enabled: false; }
    }

}
