import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Radio, RadioGroup } from "../radio.slint";

export component RadioExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    GroupBox {
        title: "Group";
        variant: GroupBoxVariant.outline;
        RadioGroup {
            options: [
                "Email",
                "SMS",
                "Push"
            ];
            selected: 0;
        }
    }
    GroupBox {
        title: "Standalone";
        variant: GroupBoxVariant.outline;
        Radio {
            label: "Disabled";
            enabled: false;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        RadioGroup {
            size: ControlSize.small;
            options: ["Small", "Compact"];
            selected: 0;
        }
        RadioGroup {
            options: ["Medium", "Default"];
            selected: 0;
        }
        RadioGroup {
            size: ControlSize.large;
            options: ["Large", "Roomy"];
            selected: 1;
        }
    }

}
