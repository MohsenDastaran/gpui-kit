import { Theme, ControlSize } from "../theme.slint";
import { GroupBox, GroupBoxVariant } from "section.slint";
import { Rating } from "../rating.slint";

export component RatingExample inherits VerticalLayout {
    horizontal-stretch: 1;
    padding: Theme.page-padding(Theme.viewport);
    spacing: 24px;
    alignment: start;

    private property <int> stars: 4;
    GroupBox {
        title: "Rate this";
        variant: GroupBoxVariant.outline;
        Rating {
            value <=> root.stars;
        }
        Text {
            text: "\{root.stars} of 5";
            color: Theme.muted-foreground;
        }
    }

    GroupBox {
        title: "Different Sizes";
        variant: GroupBoxVariant.outline;
        Rating {
            value: 3;
            size: ControlSize.small;
        }
        Rating {
            value: 3;
        }
        Rating {
            value: 4;
            size: ControlSize.large;
        }
    }

    GroupBox {
        title: "Disabled State";
        variant: GroupBoxVariant.outline;
        Rating {
            value: 2;
            read-only: true;
        }
    }

    GroupBox {
        title: "Custom Maximum";
        variant: GroupBoxVariant.outline;
        Rating {
            value: 7;
            max: 10;
        }
    }

}
