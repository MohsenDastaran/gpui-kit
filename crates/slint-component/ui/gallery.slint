import { VirtualListExample } from "examples/virtual-list.slint";

export { Theme }

export component Gallery inherits Window {
    in property <string> component: "button";

    title: "GPUI Kit — Slint";
    background: Theme.background;
    default-font-family: "Inter Variable";
    default-font-size: Theme.font-size-md;
    preferred-width: 800px;
    preferred-height: 600px;

    VerticalLayout {
        Scrollable {
            VerticalLayout {
            alignment: start;
            if component == "accordion": AccordionExample { }
            if component == "alert-dialog": AlertDialogExample { }
            if component == "alert": AlertExample { }
            if component == "attachment": AttachmentExample { }
            if component == "avatar": AvatarExample { }
            if component == "badge": BadgeExample { }
            if component == "bubble": BubbleExample { }
            if component == "button": ButtonExample { }
            if component == "calendar": CalendarExample { }
            if component == "card": CardExample { }
            if component == "carousel": CarouselExample { }
            if component == "chart": ChartExample { }
            if component == "checkbox": CheckboxExample { }
            if component == "clipboard": ClipboardExample { }
            if component == "collapsible": CollapsibleExample { }
            if component == "color-picker": ColorPickerExample { }
            if component == "combobox": ComboboxExample { }
            if component == "command": CommandExample { }
            if component == "data-table": DataTableExample { }
            if component == "date-picker": DatePickerExample { }
            if component == "description-list": DescriptionListExample { }
            if component == "dialog": DialogExample { }
            if component == "dock": DockExample { }
            if component == "dropdown_button": DropdownButtonExample { }
            if component == "editor": EditorExample { }
            if component == "empty": EmptyExample { }
            if component == "focus-trap": FocusTrapExample { }
            if component == "form": FormExample { }
            if component == "group-box": GroupBoxExample { }
            if component == "hover-card": HoverCardExample { }
            if component == "icon": IconExample { }
            if component == "image": ImageExample { }
            if component == "input-group": InputGroupExample { }
            if component == "input": InputExample { }
            if component == "kbd": KbdExample { }
            if component == "label": LabelExample { }
            if component == "list": ListExample { }
            if component == "marker": MarkerExample { }
            if component == "menu": MenuExample { }
            if component == "message": MessageExample { }
            if component == "message-scroller": MessageScrollerExample { }
            if component == "notification": NotificationExample { }
            if component == "number-input": NumberInputExample { }
            if component == "otp-input": OtpInputExample { }
            if component == "pagination": PaginationExample { }
            if component == "plot": PlotExample { }
            if component == "popover": PopoverExample { }
            if component == "progress": ProgressExample { }
            if component == "questionnaire": QuestionnaireExample { }
            if component == "radio": RadioExample { }
            if component == "rating": RatingExample { }
            if component == "resizable": ResizableExample { }
            if component == "root": RootExample { }
            if component == "scrollable": ScrollableExample { }
            if component == "select": SelectExample { }
            if component == "settings": SettingsExample { }
            if component == "sheet": SheetExample { }
            if component == "shimmer": ShimmerExample { }
            if component == "sidebar": SidebarExample { }
            if component == "skeleton": SkeletonExample { }
            if component == "slider": SliderExample { }
            if component == "spinner": SpinnerExample { }
            if component == "status-bar": StatusBarExample { }
            if component == "stepper": StepperExample { }
            if component == "switch": SwitchExample { }
            if component == "table": TableExample { }
            if component == "tabs": TabsExample { }
            if component == "tag": TagExample { }
            if component == "textarea": TextareaExample { }
            if component == "text-view": TextViewExample { }
            if component == "theme": ThemeExample { }
            if component == "title-bar": TitleBarExample { }
            if component == "toggle": ToggleExample { }
            if component == "tooltip": TooltipExample { }
            if component == "tree": TreeExample { }
            if component == "virtual-list": VirtualListExample { }
        }
        }
