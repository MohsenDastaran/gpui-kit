// The gallery the website embeds: one window showing one component's example,
// chosen by page slug. The page list is generated into gallery-catalog.slint.

import "../fonts/Inter-Regular.ttf";
import "../fonts/JetBrainsMono-Regular.ttf";
import "../fonts/NotoEmoji.ttf";

import { Theme } from "theme.slint";
import { Scrollable } from "scrollable.slint";
import { ExampleBridge } from "examples/bridge.slint";
import { GalleryCatalog } from "gallery-catalog.slint";

export { Theme, ExampleBridge }

export component Gallery inherits Window {
    in property <string> component: "button";

    title: "GPUI Kit — Slint";
    background: Theme.background;
    default-font-family: "Inter Variable";
    default-font-size: Theme.font-size-md;
    preferred-width: 800px;
    preferred-height: 600px;
    // A child that does not stretch, such as an attachment chip, would
    // otherwise publish its own width as this window's maximum. On the web
    // that maximum is written onto the canvas as max-width, so the iframe
    // cannot grow the surface. The cap has to stay above any frame size.
    max-width: 10000px;

    VerticalLayout {
        Scrollable {
            GalleryCatalog {
                component: root.component;
            }
        }
    }
}
