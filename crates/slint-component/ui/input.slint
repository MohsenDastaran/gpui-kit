import { Theme, ControlSize, ButtonVariant } from "theme.slint";
import { Icon } from "icon.slint";
import { Button } from "button.slint";

// A single-line text input. Mirrors GPUI Component's `Input`: a placeholder,
// prefix and suffix icons or text, a clear button (`cleanable`), a masked
// value with an optional reveal toggle (`mask-toggle`), read-only and disabled
// states, clean on Escape, an invalid state, sizes, and the focus ring.
// Children go after the text at the trailing edge, like GPUI's `suffix`, for a
// ghost `Button` or a `Clipboard`. `appearance: false` drops the frame so the
// input can sit inside a container that draws its own (see `InputGroup`).
export component Input {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> prefix-icon;
    in property <string> prefix-text;
    in property <string> suffix-icon;
    in property <string> suffix-text;
    in property <ControlSize> size: ControlSize.medium;
    in property <InputType> input-type: InputType.text;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <bool> enabled: true;
    in property <bool> read-only;
    in property <bool> cleanable;
    in property <bool> masked;
    in property <bool> mask-toggle;
    in property <bool> clean-on-escape;
    in property <bool> invalid;
    in property <bool> appearance: true;
    out property <bool> has-focus: field.has-focus;
    callback edited(text: string);
    callback accepted(text: string);
    callback cleared();
    // Keys the text field does not handle itself, such as Up and Down.
    callback key-pressed(event: KeyEvent) -> EventResult;

    private property <bool> revealed;
    private property <bool> focused: field.has-focus && enabled;
    private property <length> inset: Theme.input-padding-x(size);
    private property <length> text-size: Theme.input-font-size(size);
    private property <length> gap: size == ControlSize.xsmall || size == ControlSize.small ? Theme.spacing-xs : Theme.spacing-sm;
    private property <color> edge: invalid ? Theme.danger : focused ? Theme.ring : Theme.input;

    public function select-all() {
        field.select-all();
    }

    public function clear-selection() {
        field.clear-selection();
    }

    public function clear() {
        root.text = "";
        root.cleared();
        root.edited("");
    }

    forward-focus: field;
    accessible-role: text-input;
    accessible-enabled: enabled;
    accessible-read-only: read-only;
    accessible-value: text;
    accessible-placeholder-text: placeholder;
    accessible-action-set-value(value) => {
        root.text = value;
        root.edited(value);
    }

    height: Theme.input-height(size);
    min-width: 0px;
    preferred-width: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    opacity: enabled ? 1 : 0.5;

    if appearance && focused: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md + 2px;
        border-width: 2px;
        border-color: edge.with-alpha(0.5);
    }

    Rectangle {
        border-radius: appearance ? Theme.radius-md : 0;
        border-width: appearance ? 1px : 0;
        border-color: edge;
        background: !appearance ? transparent : enabled ? Theme.background : Theme.muted;
        animate border-color { duration: 100ms; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => {
            field.focus();
        }
    }

    HorizontalLayout {
        padding-left: inset;
        // The trailing slot below is always present, so the row spacing
        // before it is taken out of the trailing padding.
        padding-right: inset - self.spacing;
        spacing: gap;

        if prefix-icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: prefix-icon;
                size: Theme.icon-size(root.size);
                color: Theme.muted-foreground;
            }
        }

        if prefix-text != "": Text {
            text: prefix-text;
            color: Theme.muted-foreground;
            font-size: root.text-size;
            vertical-alignment: center;
        }

        Rectangle {
            clip: true;
            min-width: 1px;
            preferred-width: 0;
            horizontal-stretch: 1;

            Text {
                width: 100%;
                height: 100%;
                text: root.text == "" && field.preedit-text == "" ? root.placeholder : "";
                color: Theme.muted-foreground;
                font-size: root.text-size;
                horizontal-alignment: root.horizontal-alignment;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            field := TextInput {
                property <length> computed-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                text <=> root.text;
                enabled: root.enabled;
                read-only: root.read-only;
                single-line: true;
                input-type: root.masked && !root.revealed ? InputType.password : root.input-type;
                horizontal-alignment: root.horizontal-alignment;
                vertical-alignment: center;
                color: Theme.foreground;
                font-size: root.text-size;
                selection-background-color: Theme.selection.with-alpha(0.35);
                selection-foreground-color: Theme.foreground;
                accessible-role: none;

                cursor-position-changed(position) => {
                    if position.x + self.computed-x < 0 {
                        self.computed-x = -position.x;
                    } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                        self.computed-x = parent.width - position.x - self.text-cursor-width;
                    }
                }

                edited => {
                    root.edited(self.text);
                }

                accepted => {
                    root.accepted(self.text);
                }

                key-pressed(event) => {
                    if root.clean-on-escape && event.text == Key.Escape && self.text != "" && !root.read-only {
                        root.clear();
                        return accept;
                    }
                    root.key-pressed(event)
                }
            }
        }

        if suffix-text != "": Text {
            text: suffix-text;
            color: Theme.muted-foreground;
            font-size: root.text-size;
            vertical-alignment: center;
        }

        if suffix-icon != "": VerticalLayout {
            alignment: center;
            Icon {
                name: suffix-icon;
                size: Theme.icon-size(root.size);
                color: Theme.muted-foreground;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.spacing-xxs;

                if root.cleanable && root.text != "" && root.enabled && !root.read-only: Button {
                    icon: "x";
                    variant: ButtonVariant.ghost;
                    size: ControlSize.xsmall;
                    accessible-label: "Clear";
                    clicked => {
                        root.clear();
                        field.focus();
                    }
                }

                if root.masked && root.mask-toggle: Button {
                    icon: root.revealed ? "eye-off" : "eye";
                    variant: ButtonVariant.ghost;
                    size: ControlSize.xsmall;
                    enabled: root.enabled;
                    accessible-label: root.revealed ? "Hide value" : "Show value";
                    clicked => {
                        root.revealed = !root.revealed;
                    }
                }

                @children
            }
        }
    }
}
