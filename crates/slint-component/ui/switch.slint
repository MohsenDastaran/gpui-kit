import { Theme, ControlSize } from "theme.slint";

// An on/off switch. Mirrors GPUI Component's `Switch`: a label, sizes, and a
// sliding thumb.
export component Switch {
    in-out property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    in property <ControlSize> size: ControlSize.medium;
    callback changed(checked: bool);

    // GPUI uses one track for xs/sm and one for medium/large.
    private property <length> track-w: size == ControlSize.xsmall || size == ControlSize.small ? 28px : 36px;
    private property <length> track-h: size == ControlSize.xsmall || size == ControlSize.small ? 16px : 20px;
    private property <length> thumb: size == ControlSize.xsmall || size == ControlSize.small ? 12px : 16px;

    function toggle() {
        if !enabled {
            return;
        }
        root.checked = !root.checked;
        root.changed(root.checked);
    }

    accessible-role: switch;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => {
        root.toggle();
    }

    horizontal-stretch: 0;

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        alignment: start;

        VerticalLayout {
            alignment: center;
        track := Rectangle {
            width: track-w;
            height: track-h;
            border-radius: self.height / 2;
            background: !enabled ? (checked ? Theme.primary : Theme.secondary).with-alpha(0.5)
                : checked ? Theme.primary
                : Theme.secondary.darker(0.1);
            animate background { duration: 120ms; }

            Rectangle {
                x: checked ? parent.width - thumb - 2px : 2px;
                y: 2px;
                width: thumb;
                height: thumb;
                border-radius: self.width / 2;
                background: Theme.background;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
        }

        if label != "": Text {
            text: label;
            color: enabled ? Theme.foreground : Theme.muted-foreground;
            font-size: size == ControlSize.xsmall || size == ControlSize.small ? Theme.font-size-sm : Theme.font-size-md;
            vertical-alignment: center;
        }
    }

    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: track-w + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.ring;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggle();
        }
    }
}
