import { Theme, ButtonVariant } from "theme.slint";
import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";

// A confirmation dialog. Mirrors GPUI Component's `AlertDialog`.
export component AlertDialog {
    in-out property <bool> open;
    in property <string> title;
    in property <string> description;
    in property <string> cancel-text: "Cancel";
    in property <string> confirm-text: "Continue";
    in property <bool> destructive;
    callback cancelled();
    callback confirmed();

    // The preview sizes this host. The dialog inside has to fill it, or the
    // overlay and card collapse to the text and the actions land on each other.
    width: 100%;
    height: 100%;

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: root.title;
        description: root.description;
        closed => {
            root.cancelled();
        }

        DialogFooter {
            centered: true;
            Button {
                text: cancel-text;
                clicked => {
                    root.open = false;
                    root.cancelled();
                }
            }
            Button {
                text: confirm-text;
                variant: destructive ? ButtonVariant.danger : ButtonVariant.primary;
                clicked => {
                    root.open = false;
                    root.confirmed();
                }
            }
        }
    }
}
