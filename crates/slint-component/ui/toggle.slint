import { Theme, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

// A pressed-in control. Mirrors GPUI Component's `Toggle`: an optional icon
// and label, sizes, and a selected state. Use `ToggleGroup` for a mutually
// exclusive row.
export component Toggle {
    in-out property <bool> selected;
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <ControlSize> size: ControlSize.medium;
    callback changed(selected: bool);

    function toggle() {
        if !enabled {
            return;
        }
        root.selected = !root.selected;
        root.changed(root.selected);
    }

    accessible-role: button;
    accessible-label: text == "" ? icon : text;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => {
        root.toggle();
    }

    height: Theme.control-height(size);
    min-width: text == "" ? self.height : 0;
    opacity: enabled ? 1 : 0.5;
    horizontal-stretch: 0;

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: selected ? Theme.border : transparent;
        background: selected ? Theme.background : (touch.has-hover ? Theme.accent : transparent);
        animate background { duration: 100ms; }
    }

    HorizontalLayout {
        padding-left: text == "" ? 0 : Theme.control-padding(size);
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;

        if icon != "": Icon {
            name: icon;
            size: Theme.icon-size(size);
            color: Theme.foreground;
        }

        if text != "": Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.control-font-size(size);
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md + 2px;
        border-width: 2px;
        border-color: Theme.ring;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggle();
        }
    }
}

export struct ToggleOption {
    text: string,
    icon: string,
}

// A segmented row of toggles that keep one selected index.
export component ToggleGroup {
    in property <[ToggleOption]> options;
    in-out property <int> selected: 0;
    in property <ControlSize> size: ControlSize.medium;
    callback changed(index: int);

    height: Theme.control-height(size);
    horizontal-stretch: 0;

    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.muted;
    }

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for option[index] in options: Toggle {
            text: option.text;
            icon: option.icon;
            selected: root.selected == index;
            size: root.size;
            changed => {
                root.selected = index;
                root.changed(index);
            }
        }
    }
}
