import { Badge } from "badge.slint";
import { Theme, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Badge {
            horizontal-stretch: 0; count: 1; size: ControlSize.small;
            Icon { name: "bell"; size: 24px; color: Theme.foreground; }
        }
    }
}
