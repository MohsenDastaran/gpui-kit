import { Stepper } from "stepper.slint";
import { Theme, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Stepper { horizontal-stretch: 1; items: [{ label: "stepper", description: "", icon: "", disabled: false }, { label: "stepper", description: "", icon: "", disabled: false }, { label: "stepper", description: "", icon: "", disabled: false }]; size: ControlSize.xsmall; }
    }
}
