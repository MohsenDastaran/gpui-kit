import { Attachment } from "attachment.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Attachment { horizontal-stretch: 0; name: "2026-08-25-very-long-export-name.json"; size: "JSON · 18.4 MB"; progress: 100; }
    }
}
