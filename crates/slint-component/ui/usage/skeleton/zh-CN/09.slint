import { Skeleton } from "skeleton.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Skeleton { height: 16px; horizontal-stretch: 1; }
        Skeleton { height: 12px; horizontal-stretch: 1; }
        Skeleton { height: 12px; preferred-width: 160px; horizontal-stretch: 1; }
    }
}
