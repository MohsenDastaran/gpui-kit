import { NumberInput } from "number-input.slint";
import { Theme, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        NumberInput { horizontal-stretch: 1; value: 1; size: ControlSize.small; }
    }
}
