import { Settings } from "settings.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Settings { horizontal-stretch: 1; rows: [{ title: "CLI Path", description: "/usr/local/bin/bash", checked: true }, { title: "/usr/local/bin/bash", description: "Path to the CLI executable.", checked: false }, { title: "Path to the CLI executable.", description: "", checked: false }]; }
    }
}
