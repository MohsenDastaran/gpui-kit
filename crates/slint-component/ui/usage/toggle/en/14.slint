import { Toggle, ToggleGroup } from "toggle.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        ToggleGroup { horizontal-stretch: 0; options: [{ text: "Filter by status", icon: "" }, { text: "status-filters", icon: "" }, { text: "Completed", icon: "" }]; }
    }
}
