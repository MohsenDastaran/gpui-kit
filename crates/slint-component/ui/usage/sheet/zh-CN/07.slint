import { Sheet } from "sheet.slint";
import { Theme } from "theme.slint";
import { Button } from "button.slint";
import { Placement } from "dialog.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open: true;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Button { text: "Resizable Panel"; horizontal-stretch: 0; clicked => { root.open = true; } }
    }
Sheet {
    width: 100%;
    height: 100%;
    open <=> root.open;
    placement: Placement.right;
    title: "Resizable Panel";
    description: "Resizable Panel";
}
}
