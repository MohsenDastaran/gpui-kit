import { Form, FormField } from "form.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Form {
            horizontal-stretch: 1;
            FormField {
                horizontal-stretch: 1; label: "Bio"; description: "Use at most 100 words to describe yourself.";
                Text { text: "Field"; color: Theme.foreground; wrap: word-wrap; }
            }
        }
    }
}
