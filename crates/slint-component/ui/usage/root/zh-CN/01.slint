import { Root } from "root.slint";
import { Theme } from "theme.slint";
import { Button } from "button.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        app := Root {
            horizontal-stretch: 1;
            height: 280px;
            dialog-title: "Notice";
            dialog-description: "A dialog owned by the window.";
            Button { text: "Open"; horizontal-stretch: 0; clicked => { app.dialog-open = true; } }
        }
    }
}
