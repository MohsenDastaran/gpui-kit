import { Menu } from "menu.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Menu { horizontal-stretch: 0; items: [{ label: "Documentation", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "https://docs.example.com", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "GitHub", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "https://github.com/example/repo", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Support", icon: "", shortcut: "", disabled: false, checked: false, separator: false }]; }
    }
}
