import { Menu } from "menu.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Menu { horizontal-stretch: 0; items: [{ label: "file-manager", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Right-click for options", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Open", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Copy", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Cut", icon: "", shortcut: "", disabled: false, checked: false, separator: false }]; }
    }
}
