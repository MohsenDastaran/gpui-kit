import { Menu } from "menu.slint";
import { Theme, Status } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Menu { horizontal-stretch: 0; items: [{ label: "Custom Element", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "This is a subtitle", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "Status", icon: "", shortcut: "", disabled: false, checked: false, separator: false }, { label: "✓ Connected", icon: "", shortcut: "", disabled: false, checked: false, separator: false }]; }
    }
}
