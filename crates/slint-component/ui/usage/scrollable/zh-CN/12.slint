import { Scrollable } from "scrollable.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Scrollable {
            horizontal-stretch: 1; height: 120px;
            Text { text: "Scroll this region to see the rest of the note. Scroll this region to see the rest of the note."; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
