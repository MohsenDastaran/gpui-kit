import { AlertDialog } from "alert-dialog.slint";
import { Button } from "button.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;
    private property <string> note;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 12px;
        Button {
            text: "Open Confirmation";
            clicked => { root.open = true; }
        }
        Text {
            text: root.note;
            color: Theme.muted-foreground;
            font-size: Theme.font-size-sm;
        }
    }

    AlertDialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: "Confirm";
        description: "Are you sure?";
        confirm-text: "OK";
        confirmed => { root.note = "Confirmed"; }
        cancelled => { root.note = "Cancelled"; }
    }
}
