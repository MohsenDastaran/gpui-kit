import { AlertDialog } from "alert-dialog.slint";
import { Button } from "button.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Show Alert";
            clicked => { root.open = true; }
        }
    }

    AlertDialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: "Are you absolutely sure?";
        description: "This action cannot be undone. This will permanently delete your account from our servers.";
        cancel-text: "Cancel";
        confirm-text: "Continue";
    }
}
