import { Button } from "button.slint";
import { Dialog } from "dialog.slint";
import { Icon } from "icon.slint";
import { ButtonVariant, Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Request Permission";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            Icon { name: "triangle-alert"; size: 40px; color: Theme.warning; }
            Text {
                text: "Network Permission Required";
                color: Theme.foreground;
                font-size: Theme.font-size-lg;
                font-weight: 600;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: "We need your permission to access the network to provide better services.";
                color: Theme.muted-foreground;
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 8px;
            Button {
                text: "Allow";
                variant: ButtonVariant.primary;
                horizontal-stretch: 1;
                clicked => { root.open = false; }
            }
            Button {
                text: "Don't Allow";
                outline: true;
                horizontal-stretch: 1;
                clicked => { root.open = false; }
            }
        }
    }
}
