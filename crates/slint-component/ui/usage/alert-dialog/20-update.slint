import { Button } from "button.slint";
import { Dialog } from "dialog.slint";
import { ButtonVariant, Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Update Available";
            outline: true;
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Update Available";
        description: "A new version (v2.0.0) is available. This update includes new features and bug fixes.";
        Rectangle {
            background: Theme.muted;
            border-radius: Theme.radius-md;
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                Button {
                    text: "Later";
                    outline: true;
                    horizontal-stretch: 1;
                    clicked => { root.open = false; }
                }
                Button {
                    text: "Update Now";
                    variant: ButtonVariant.primary;
                    horizontal-stretch: 1;
                    clicked => { root.open = false; }
                }
            }
        }
    }
}
