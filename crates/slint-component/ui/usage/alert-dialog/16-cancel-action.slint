import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Open Dialog";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Discard changes?";
        description: "Cancel closes the dialog without applying the action.";
        DialogFooter {
            centered: true;
            Button {
                text: "Cancel";
                clicked => { root.open = false; }
            }
        }
    }
}
