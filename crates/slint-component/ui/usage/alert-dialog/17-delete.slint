import { AlertDialog } from "alert-dialog.slint";
import { Button } from "button.slint";
import { ButtonVariant } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Delete";
            variant: ButtonVariant.danger;
            clicked => { root.open = true; }
        }
    }

    AlertDialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: "Delete File?";
        description: "This action cannot be undone.";
        cancel-text: "Cancel";
        confirm-text: "Delete";
        destructive: true;
        confirmed => { }
    }
}
