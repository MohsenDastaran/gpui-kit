import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";
import { Icon } from "icon.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Show Warning";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        HorizontalLayout {
            spacing: 12px;
            Icon { name: "triangle-alert"; size: 32px; color: Theme.warning; }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Warning";
                    color: Theme.foreground;
                    font-size: Theme.font-size-lg;
                    font-weight: 600;
                }
                Text {
                    text: "This action requires confirmation.";
                    color: Theme.muted-foreground;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }
        DialogFooter {
            centered: true;
            Button {
                text: "Continue";
                clicked => { root.open = false; }
            }
        }
    }
}
