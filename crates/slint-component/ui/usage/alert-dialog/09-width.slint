import { AlertDialog } from "alert-dialog.slint";
import { Button } from "button.slint";

export component Example inherits Window {
    preferred-width: 560px;
    preferred-height: 400px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Custom Width";
            clicked => { root.open = true; }
        }
    }

    // The card follows this frame, up to 440px.
    if root.open: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 500px;
        height: 320px;
        clip: true;
        AlertDialog {
            width: 100%;
            height: 100%;
            open <=> root.open;
            title: "Custom Width";
            description: "The dialog is laid out inside a 500px frame.";
            confirm-text: "OK";
        }
    }
}
