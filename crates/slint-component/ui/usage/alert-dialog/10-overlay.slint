import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Show Notice";
            clicked => { root.open = true; }
        }
    }

    // Clicking the overlay sets open to false.
    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Notice";
        description: "Click outside this dialog to close it.";
        DialogFooter {
            centered: true;
            Button {
                text: "OK";
                clicked => { root.open = false; }
            }
        }
    }
}
