import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";
import { ButtonVariant } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;
    private property <string> note: "A process is running. The dialog stays open until you dismiss it yourself.";

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Start Process";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Processing";
        description: root.note;
        DialogFooter {
            centered: true;
            Button {
                text: "Cancel";
                clicked => { root.note = "Still waiting."; }
            }
            Button {
                text: "Continue";
                variant: ButtonVariant.primary;
                clicked => { root.note = "Cannot close while this is running."; }
            }
        }
    }
}
