import { Button } from "button.slint";
import { Dialog, DialogFooter } from "dialog.slint";
import { ButtonVariant } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Show Alert";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Are you absolutely sure?";
        description: "This action cannot be undone. This will permanently delete your account from our servers.";
        DialogFooter {
            centered: true;
            Button {
                text: "Cancel";
                clicked => { root.open = false; }
            }
            Button {
                text: "Continue";
                variant: ButtonVariant.primary;
                clicked => { root.open = false; }
            }
        }
    }
}
