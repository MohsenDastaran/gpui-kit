import { Button } from "button.slint";
import { Dialog } from "dialog.slint";
import { ButtonVariant } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    private property <bool> open;

    VerticalLayout {
        padding: 24px;
        alignment: start;
        Button {
            text: "Show Session Expiry";
            clicked => { root.open = true; }
        }
    }

    Dialog {
        width: 100%;
        height: 100%;
        open <=> root.open;
        show-close: false;
        title: "Session Expired";
        description: "Your session has expired due to inactivity. Please log in again to continue.";
        Button {
            text: "Sign in";
            variant: ButtonVariant.primary;
            horizontal-stretch: 1;
            clicked => { root.open = false; }
        }
    }
}
