import { ShimmerText } from "shimmer.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        ShimmerText { horizontal-stretch: 1; text: "Generating a response…"; wrap: word-wrap; }
    }
}
