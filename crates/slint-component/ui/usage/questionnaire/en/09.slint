import { Questionnaire } from "questionnaire.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Questionnaire { horizontal-stretch: 1; questions: [{ prompt: "Current item: (:?)", options: ["Changed: (:?) ((:?))", "Answers: (:?)"] }, { prompt: "Changed: (:?) ((:?))", options: ["Changed: (:?) ((:?))", "Answers: (:?)"] }]; }
    }
}
