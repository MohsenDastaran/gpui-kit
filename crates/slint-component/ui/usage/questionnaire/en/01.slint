import { Questionnaire } from "questionnaire.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Questionnaire { horizontal-stretch: 1; questions: [{ prompt: "Type another answer…", options: ["direction", "What should we prototype next?"] }, { prompt: "direction", options: ["direction", "What should we prototype next?"] }]; }
    }
}
