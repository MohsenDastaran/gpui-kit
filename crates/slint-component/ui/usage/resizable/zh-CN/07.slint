import { Resizable } from "resizable.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Resizable {
            horizontal-stretch: 1;
            Text { text: "Sidebar Content"; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
