import { Card } from "card.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Card {
            horizontal-stretch: 1; title: "Team"; description: "Team";
            Text { text: "3 members"; color: Theme.muted-foreground; wrap: word-wrap; }
        }
    }
}
