import { Collapsible } from "collapsible.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Collapsible {
            horizontal-stretch: 1; title: ",     )     .content(";
            Text { text: ",     )     .child(         h_flex().justify_center().child(             Button::new("; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
