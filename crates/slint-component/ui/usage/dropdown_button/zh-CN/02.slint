import { DropdownButton } from "dropdown_button.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DropdownButton { horizontal-stretch: 0; text: "Primary"; items: [{ label: "Primary", icon: "", shortcut: "", disabled: false, checked: false, separator: false }]; }
    }
}
