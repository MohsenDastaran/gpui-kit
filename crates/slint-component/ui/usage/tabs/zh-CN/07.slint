import { Tabs, TabsVariant } from "tabs.slint";
import { Theme, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Tabs {
            horizontal-stretch: 1; items: [{ label: "Small", icon: "", disabled: false }, { label: "Small", icon: "", disabled: false }, { label: "Medium", icon: "", disabled: false }, { label: "Large", icon: "", disabled: false }]; variant: TabsVariant.underline; size: ControlSize.xsmall;
            Text { text: "tabs"; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
