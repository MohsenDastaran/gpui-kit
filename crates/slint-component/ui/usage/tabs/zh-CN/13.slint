import { Tabs, TabsVariant } from "tabs.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Tabs {
            horizontal-stretch: 1; items: [{ label: "Account Settings & Preferences", icon: "", disabled: false }, { label: "Documents & Files", icon: "", disabled: false }, { label: "Appearance & Themes", icon: "", disabled: false }]; variant: TabsVariant.underline;
            Text { text: "Appearance & Themes"; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
