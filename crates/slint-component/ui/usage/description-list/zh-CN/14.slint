import { DescriptionList, DescriptionLayout } from "description-list.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DescriptionList { horizontal-stretch: 1; items: [{ term: "Theme", detail: "Active" }, { term: "Font Size", detail: "Font Size" }, { term: "Auto Save", detail: "14px" }, { term: "Backup Frequency", detail: "Auto Save" }]; layout: DescriptionLayout.horizontal; }
    }
}
