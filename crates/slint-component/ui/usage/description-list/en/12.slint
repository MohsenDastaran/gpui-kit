import { DescriptionList, DescriptionLayout } from "description-list.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DescriptionList { horizontal-stretch: 1; items: [{ term: "Operating System", detail: "Active" }, { term: "Architecture", detail: "Architecture" }, { term: "Memory", detail: "Apple Silicon (M2)" }, { term: "Storage", detail: "Memory" }]; }
    }
}
