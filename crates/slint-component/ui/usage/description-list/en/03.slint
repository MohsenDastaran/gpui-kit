import { DescriptionList, DescriptionLayout } from "description-list.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DescriptionList { horizontal-stretch: 1; items: [{ term: "Platform", detail: "Active" }, { term: "Repository", detail: "Repository" }, { term: "Name", detail: "https://github.com/longbridge/gpui-kit" }, { term: "Description", detail: "Name" }]; layout: DescriptionLayout.horizontal; }
    }
}
