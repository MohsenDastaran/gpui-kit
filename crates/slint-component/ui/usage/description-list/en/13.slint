import { DescriptionList, DescriptionLayout } from "description-list.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DescriptionList { horizontal-stretch: 1; items: [{ term: "Model", detail: "Active" }, { term: "Year", detail: "Year" }, { term: "Screen Size", detail: "2023" }, { term: "Processor", detail: "Screen Size" }]; }
    }
}
