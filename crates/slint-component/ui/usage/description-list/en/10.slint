import { DescriptionList, DescriptionLayout } from "description-list.slint";
import { Theme, Status } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        DescriptionList { horizontal-stretch: 1; items: [{ term: "Project Name", detail: "Active" }, { term: "Version", detail: "Version" }, { term: "Status", detail: "0.1.0" }, { term: "Description", detail: "Status" }]; }
    }
}
