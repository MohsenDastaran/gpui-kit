import { RadioGroup } from "radio.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 180px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        RadioGroup { options: ["United States", "Canada", "Mexico"]; selected: 0; horizontal-stretch: 1; }
    }
}
