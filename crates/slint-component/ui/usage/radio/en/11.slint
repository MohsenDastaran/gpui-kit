import { RadioGroup } from "radio.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 180px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        RadioGroup { options: ["Option A", "Option B", "Option C"]; selected: 0; horizontal-stretch: 1; }
    }
}
