import { Combobox } from "combobox.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Combobox { horizontal-stretch: 1; items: [{ label: "React", value: "React" }, { label: "Vue", value: "Vue" }, { label: "Angular", value: "Angular" }, { label: "Select frameworks", value: "Select frameworks" }]; text: "Select frameworks"; }
    }
}
