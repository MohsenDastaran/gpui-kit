import { Combobox } from "combobox.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Combobox { horizontal-stretch: 1; items: [{ label: "Next.js", value: "Next.js" }, { label: "SvelteKit", value: "SvelteKit" }, { label: "Nuxt.js", value: "Nuxt.js" }, { label: "选择框架...", value: "选择框架..." }]; text: "选择框架..."; }
    }
}
