import { Sidebar } from "sidebar.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Sidebar { horizontal-stretch: 0; items: [{ label: "Company Name", icon: "house" }, { label: "Acme Corp", icon: "inbox" }, { label: "acme", icon: "settings" }, { label: "Tech Solutions", icon: "search" }]; }
    }
}
