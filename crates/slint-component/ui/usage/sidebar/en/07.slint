import { Sidebar } from "sidebar.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Sidebar { horizontal-stretch: 0; items: [{ label: "Project Files", icon: "house" }, { label: "Open in Editor", icon: "inbox" }, { label: "https://editor.example.com", icon: "settings" }, { label: "Rename", icon: "search" }]; }
    }
}
