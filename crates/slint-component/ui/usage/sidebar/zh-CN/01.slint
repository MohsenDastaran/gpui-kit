import { Sidebar } from "sidebar.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Sidebar { horizontal-stretch: 0; items: [{ label: "My Application", icon: "house" }, { label: "Navigation", icon: "inbox" }, { label: "Dashboard", icon: "settings" }, { label: "Dashboard clicked", icon: "search" }]; }
    }
}
