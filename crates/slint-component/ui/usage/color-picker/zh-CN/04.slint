import { ColorPicker } from "color-picker.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        ColorPicker { horizontal-stretch: 1; swatches: [{ name: "Ink", fill: #171717 }, { name: "Paper", fill: #fafafa }, { name: "Blue", fill: #1d4ed8 }]; }
    }
}
