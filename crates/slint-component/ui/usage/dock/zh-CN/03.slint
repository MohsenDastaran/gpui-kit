import { Dock } from "dock.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Dock {
            horizontal-stretch: 1; tabs: [{ title: "main.rs" }, { title: "lib.rs" }];
            Text { text: "Panel"; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
