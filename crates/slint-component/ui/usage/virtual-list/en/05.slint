import { VirtualList } from "virtual-list.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        VirtualList { horizontal-stretch: 1; items: [{ label: "Row 1" }, { label: "Row 2" }, { label: "Row 3" }, { label: "Row 4" }, { label: "Row 5" }, { label: "Row 6" }]; height: 160px; }
    }
}
