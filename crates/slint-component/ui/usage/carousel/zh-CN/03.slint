import { Carousel } from "carousel.slint";
import { Theme } from "theme.slint";
export component Example inherits Window {
    preferred-width: 520px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: center;
        Carousel {
            count: 3;
            vertical: true;
            visible-items: 2;
            frame: 192px;
            cross: 256px;
            label-size: 30px;
        }
    }
}
