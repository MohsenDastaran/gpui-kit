import { Carousel } from "carousel.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Carousel { horizontal-stretch: 1; slides: [
                { title: "project", body: "项目 ()" },
                { title: "项目 ()", body: "Slide" }
            ]; }
    }
}
