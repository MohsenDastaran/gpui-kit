import { Carousel } from "carousel.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Carousel { horizontal-stretch: 1; slides: [
                { title: "projects-carousel", body: "project-1" },
                { title: "project-1", body: "项目一" },
                { title: "项目一", body: "project-2" }
            ]; }
    }
}
