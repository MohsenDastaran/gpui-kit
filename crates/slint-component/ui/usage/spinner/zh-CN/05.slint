import { Spinner } from "spinner.slint";
import { Theme, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Spinner { horizontal-stretch: 0; size: ControlSize.large; color: Theme.foreground; }
    }
}
