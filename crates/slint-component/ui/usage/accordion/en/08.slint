import { Accordion } from "accordion.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Accordion { horizontal-stretch: 1; items: [
                { title: "Parent Section", icon: "", content: "Content" },
                { title: "Child 1", icon: "", content: "Content" },
                { title: "Child 2", icon: "", content: "Child 1" }
            ]; }
    }
}
