import { Accordion } from "accordion.slint";
import { Theme, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Accordion { horizontal-stretch: 1; size: ControlSize.small; items: [
                { title: "Small Section", icon: "", content: "Content" },
                { title: "Large Section", icon: "", content: "Content" }
            ]; }
    }
}
