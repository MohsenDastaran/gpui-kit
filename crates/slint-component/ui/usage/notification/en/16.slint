import { Notification } from "notification.slint";
import { Theme, Status } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Notification { horizontal-stretch: 1; title: "Operation Results"; message: "## Batch Operation Complete  **Processed**: 150 items **Success**: 147 items **Failed**: 3 it..."; status: Status.success; }
    }
}
