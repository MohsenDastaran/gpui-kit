import { Tag, TagVariant } from "tag.slint";
import { Theme, ControlSize, Status } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Tag { horizontal-stretch: 0; text: "Small Pill"; variant: TagVariant.outline; status: Status.success; size: ControlSize.small; }
    }
}
