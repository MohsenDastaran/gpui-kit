import { HoverCard } from "hover-card.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        HoverCard {
            horizontal-stretch: 0; title: "custom-styled"; description: "custom-styled";
            Text { text: "custom-styled"; color: Theme.foreground; }
        }
    }
}
