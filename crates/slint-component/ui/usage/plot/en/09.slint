import { Plot } from "plot.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Plot { horizontal-stretch: 1; points: [{ label: "A", value: 1.0 }, { label: "B", value: 0.05 }, { label: "C", value: 2.0 }]; x-label: "X"; y-label: "Y"; }
    }
}
