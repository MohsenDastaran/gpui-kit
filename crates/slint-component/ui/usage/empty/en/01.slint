import { Empty } from "empty.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Empty { horizontal-stretch: 1; title: "No projects yet"; description: "No projects yet"; }
    }
}
