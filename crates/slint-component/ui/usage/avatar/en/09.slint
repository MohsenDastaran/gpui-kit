import { Avatar, AvatarGroup, AvatarSize } from "avatar.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        AvatarGroup {
            Avatar { initials: "A"; size: AvatarSize.xsmall; horizontal-stretch: 0; }
        Avatar { initials: "B"; size: AvatarSize.xsmall; horizontal-stretch: 0; }
        Avatar { initials: "C"; size: AvatarSize.xsmall; horizontal-stretch: 0; }
        Avatar { initials: "A"; size: AvatarSize.xsmall; horizontal-stretch: 0; }
        }
    }
}
