import { Tooltip, Placement } from "tooltip.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Tooltip {
            horizontal-stretch: 0; text: "Save the current document"; placement: Placement.top;
            Text { text: "Save"; color: Theme.foreground; }
        }
    }
}
