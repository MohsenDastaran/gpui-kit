import { Command } from "command.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        Command { horizontal-stretch: 1; items: [{ label: "compact", icon: "search", shortcut: "", group: "" }, { label: "expanded", icon: "search", shortcut: "", group: "" }]; }
    }
}
