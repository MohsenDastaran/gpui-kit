import { BarChart, ChartLegend } from "chart.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        BarChart { horizontal-stretch: 1; points: [{ label: "Data period label", value: 12.0 }, { label: "Summary statistic", value: 28.0 }, { label: "Additional context", value: 18.0 }]; }
    }
}
