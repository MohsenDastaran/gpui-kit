import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        LineChart { points: [
            { label: "Jan", value: 100 },
            { label: "Feb", value: 150 },
            { label: "Mar", value: 120 },
            { label: "Apr", value: 180 },
            { label: "May", value: 160 },
            { label: "Jun", value: 200 },
        ]; stroke: Theme.chart-1; }
    }
}
