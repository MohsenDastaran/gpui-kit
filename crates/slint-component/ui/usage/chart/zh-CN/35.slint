import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        AreaChart { series: [
            { label: "Jan", a: 40, b: 28 },
            { label: "Feb", a: 48, b: 31 },
            { label: "Mar", a: 51, b: 36 },
            { label: "Apr", a: 46, b: 33 },
        ]; stacked: true; }
    }
}
