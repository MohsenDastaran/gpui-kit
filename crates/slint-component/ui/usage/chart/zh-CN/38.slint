import { BarChart, ChartLegend } from "chart.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        BarChart { horizontal-stretch: 1; points: [{ label: "Mon", value: 300.0 }, { label: "Tue", value: 600.0 }, { label: "Wed", value: 300.0 }, { label: "Thu", value: 600.0 }]; }
    }
}
