import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 400px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        SankeyChart { nodes: [
            { name: "Revenue", value: 97, column: 0, slot: 1, tone: 0 },
            { name: "Gross profit", value: 18, column: 1, slot: 0, tone: 1 },
            { name: "Cost", value: 79, column: 1, slot: 2, tone: 4 },
        ]; links: [
            { from-column: 0, from-slot: 1, to-column: 1, to-slot: 0, value: 72, tone: 1 },
            { from-column: 0, from-slot: 1, to-column: 1, to-slot: 2, value: 90, tone: 4 },
        ]; }
    }
}
