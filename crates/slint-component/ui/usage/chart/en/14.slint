import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 400px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        PieChart { points: [
            { label: "Direct", value: 38 },
            { label: "Search", value: 27 },
            { label: "Social", value: 18 },
            { label: "Referral", value: 11 },
        ]; }
        ChartLegend { points: [
            { label: "Direct", value: 38 },
            { label: "Search", value: 27 },
            { label: "Social", value: 18 },
            { label: "Referral", value: 11 },
        ]; }
    }
}
