import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 380px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        BarChart { points: [
            { label: "Q1", value: 12 },
            { label: "Q2", value: -6 },
            { label: "Q3", value: 9 },
            { label: "Q4", value: -3 },
        ]; }
    }
}
