import { BarChart, ChartLegend } from "chart.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        BarChart { horizontal-stretch: 1; points: [{ label: "Jan", value: 100.0 }, { label: "Feb", value: 150.0 }, { label: "Mar", value: 120.0 }]; }
    }
}
