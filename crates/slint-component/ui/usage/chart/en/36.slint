import { Theme } from "theme.slint";
import { LineChart, AreaChart, BarChart, PieChart, RadarChart, CandlestickChart, SankeyChart, ChartLegend, LineInterpolation, BarAlign } from "chart.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 360px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        CandlestickChart { points: [
            { label: "Mon", open: 102, high: 108, low: 100, close: 106 },
            { label: "Tue", open: 106, high: 110, low: 103, close: 104 },
            { label: "Wed", open: 104, high: 107, low: 98, close: 99 },
            { label: "Thu", open: 99, high: 105, low: 97, close: 103 },
            { label: "Fri", open: 103, high: 112, low: 102, close: 111 },
        ]; min-price: 90; max-price: 120; }
    }
}
