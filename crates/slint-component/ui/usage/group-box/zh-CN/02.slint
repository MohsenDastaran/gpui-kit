import { GroupBox, GroupBoxVariant } from "group-box.slint";
import { Theme } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 280px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Theme.page-padding(Theme.viewport);
        spacing: 12px;
        alignment: start;
        GroupBox {
            horizontal-stretch: 1; title: "Settings"; variant: GroupBoxVariant.fill;
            Text { text: "Settings"; color: Theme.foreground; wrap: word-wrap; }
        }
    }
}
