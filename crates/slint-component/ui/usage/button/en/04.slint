import { Button } from "button.slint";
import { ButtonVariant, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 240px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        Button { text: "Primary Outline"; variant: ButtonVariant.primary; outline: true; horizontal-stretch: 0; }
        Button { text: "Danger Outline"; variant: ButtonVariant.danger; outline: true; horizontal-stretch: 0; }
    }
}
