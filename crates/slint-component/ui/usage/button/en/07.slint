import { Button } from "button.slint";
import { ButtonVariant, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 240px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        Button { text: "Confirm"; icon: "check"; horizontal-stretch: 0; }
        Button { text: "Like"; icon: "heart"; horizontal-stretch: 0; }
        Button { text: "Button"; icon: "search"; horizontal-stretch: 0; }
    }
}
