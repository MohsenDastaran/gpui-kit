import { Button } from "button.slint";
import { ButtonVariant, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 240px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        Button { text: "One"; horizontal-stretch: 0; }
        Button { text: "Two"; horizontal-stretch: 0; }
        Button { text: "Three"; horizontal-stretch: 0; }
    }
}
