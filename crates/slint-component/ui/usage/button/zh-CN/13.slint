import { Button } from "button.slint";
import { ButtonVariant, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 240px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        Button { text: "Disabled"; enabled: false; horizontal-stretch: 0; }
        Button { text: "Loading"; icon: "loader-circle"; horizontal-stretch: 0; }
        Button { text: "Selected"; selected: true; horizontal-stretch: 0; }
    }
}
