import { Button } from "button.slint";
import { ButtonVariant, ControlSize } from "theme.slint";

export component Example inherits Window {
    preferred-width: 480px;
    preferred-height: 240px;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        spacing: 8px;
        Button { text: "Primary"; variant: ButtonVariant.primary; horizontal-stretch: 0; }
        Button { text: "Secondary"; horizontal-stretch: 0; }
        Button { text: "Delete"; variant: ButtonVariant.danger; horizontal-stretch: 0; }
        Button { text: "Warning"; variant: ButtonVariant.warning; horizontal-stretch: 0; }
        Button { text: "Success"; variant: ButtonVariant.success; horizontal-stretch: 0; }
        Button { text: "Info"; variant: ButtonVariant.info; horizontal-stretch: 0; }
        Button { text: "Ghost"; variant: ButtonVariant.ghost; horizontal-stretch: 0; }
        Button { text: "Link"; variant: ButtonVariant.link; horizontal-stretch: 0; }
        Button { text: "Text"; variant: ButtonVariant.text; horizontal-stretch: 0; }
    }
}
