import { Theme, Status, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

// A callout for user attention. Mirrors GPUI Component's `Alert`: status
// variants, an optional title, sizes, a closable banner, and custom icons.
// `open` is the visibility flag. Formatted body content goes in `@children`.
export component Alert {
    in property <string> title;
    in property <string> message;
    in property <Status> status: Status.info;
    in property <string> icon;
    in property <bool> closable;
    in property <bool> banner;
    in property <ControlSize> size: ControlSize.medium;
    in-out property <bool> open: true;
    callback closed();

    private property <color> tone: Theme.status-color(status);
    // GPUI keeps 4% of the status color in the fill. `mix` applies `factor` to
    // the receiver, so 0.04 is a tint. The border is the status color at 30% opacity.
    private property <color> ink: status == Status.default ? Theme.foreground : tone;
    private property <color> fill: status == Status.default ? Theme.background : tone.mix(Theme.background, 0.04);
    private property <color> edge: status == Status.default ? Theme.border : tone.with-alpha(0.3);
    private property <string> glyph: icon != "" ? icon
        : status == Status.success ? "circle-check"
        : status == Status.warning ? "triangle-alert"
        : status == Status.danger ? "circle-x"
        : "info";
    // GPUI keeps text-sm at every size and only changes padding, gap, and radius.
    private property <length> pad-x: size == ControlSize.large ? 20px
        : size == ControlSize.medium ? 16px
        : 12px;
    private property <length> pad-y: size == ControlSize.xsmall ? 6px
        : size == ControlSize.small ? 8px
        : size == ControlSize.large ? 14px
        : 10px;
    private property <length> content-gap: size == ControlSize.xsmall || size == ControlSize.small ? 6px : 12px;
    private property <length> corner: size == ControlSize.large ? Theme.radius-lg : Theme.radius-md;

    visible: root.open;
    horizontal-stretch: 1;

    Rectangle {
        horizontal-stretch: 1;
        border-radius: banner ? 0 : corner;
        border-width: 1px;
        border-color: edge;
        background: fill;

        HorizontalLayout {
            width: 100%;
            padding-left: banner ? 12px : pad-x;
            padding-right: self.padding-left;
            padding-top: banner ? 8px : pad-y;
            padding-bottom: self.padding-top;
            spacing: banner ? 12px : content-gap;
            // `start` packs every item at its preferred width and drops
            // stretch, which leaves the close control beside the title.
            // Stretch gives the message column the leftover width so the
            // control stays on the trailing edge.
            alignment: stretch;
            cross-axis-alignment: banner ? center : start;

            VerticalLayout {
                alignment: start;
                padding-top: banner ? 0px : 2px;
                Icon {
                    name: glyph;
                    size: 16px;
                    color: ink;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                if title != "" && !banner: Text {
                    text: title;
                    color: ink;
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if message != "": Text {
                    text: message;
                    color: ink;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
                @children
            }

            if closable: VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                padding-top: banner ? 0px : 1px;

                close := Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: Theme.radius-sm;
                    background: close-touch.pressed ? ink.with-alpha(0.16)
                        : close-touch.has-hover ? ink.with-alpha(0.1)
                        : transparent;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: "x";
                        size: 14px;
                        color: ink;
                    }

                    close-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Dismiss";
                        clicked => {
                            root.open = false;
                            root.closed();
                        }
                    }
                }
            }
        }
    }
}
