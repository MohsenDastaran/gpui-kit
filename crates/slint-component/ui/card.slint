import { Theme, ControlSize } from "theme.slint";
import { Tag } from "tag.slint";

// A content container. Mirrors GPUI Component's `Card`: a title, description,
// body, optional footer, and a bordered surface. `badge` is a label above the
// title, `cover` an image above the header. `inset` is the padding and the
// gap between those sections. `size` small tightens that inset.
export component Card inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> badge;
    in property <image> cover;
    in property <ControlSize> size: ControlSize.medium;
    // Padding and the gap between the header, body, and footer.
    in property <length> inset: size == ControlSize.small ? 12px : 16px;

    spacing: 0;
    horizontal-stretch: 1;
    min-width: 0px;

    Rectangle {
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.background;
        clip: true;

        VerticalLayout {
            spacing: 0;

            if cover.width > 0: Image {
                width: 100%;
                height: 160px;
                image-fit: ImageFit.cover;
                source: cover;
            }

            VerticalLayout {
                padding: root.inset;
                spacing: root.inset;

                if badge != "" || title != "" || description != "": VerticalLayout {
                    spacing: 4px;
                    if badge != "": Tag {
                        text: badge;
                        size: ControlSize.small;
                    }
                    if title != "": Text {
                        text: title;
                        color: Theme.foreground;
                        font-size: size == ControlSize.small ? Theme.font-size-sm : Theme.font-size-md;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if description != "": Text {
                        text: description;
                        color: Theme.muted-foreground;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                @children
            }
        }
    }
}

export component CardFooter inherits HorizontalLayout {
    spacing: 8px;
    alignment: end;
}
