import { Theme, ControlSize } from "theme.slint";
import { Icon } from "icon.slint";

// An overlay on an icon or avatar. Mirrors GPUI Component's `Badge`: a count,
// a dot, or a small status icon anchored to the corner of its child.
export component Badge {
    in property <int> count;
    in property <int> max: 99;
    in property <string> icon;
    in property <color> color: Theme.danger;
    in property <bool> dot;
    in property <ControlSize> size: ControlSize.medium;

    private property <bool> number: !dot && icon == "" && count > 0;
    private property <string> label: count > max ? "\{max}+" : "\{count}";
    private property <length> chip: size == ControlSize.large ? 24px
        : size == ControlSize.small || size == ControlSize.xsmall ? 10px
        : 16px;

    horizontal-stretch: 0;
    vertical-stretch: 0;

    host := VerticalLayout {
        alignment: center;
        @children
    }

    if dot && (count > 0 || icon == ""): Rectangle {
        x: host.width - self.width;
        y: 0px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: color;
    }

    if icon != "" && !dot: Rectangle {
        x: host.width - chip + 2px;
        y: host.height - chip + 2px;
        width: chip;
        height: chip;
        border-radius: chip / 2;
        border-width: 1px;
        border-color: Theme.background;
        background: color;

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: icon;
            size: chip * 0.62;
            color: #ffffff;
        }
    }

    if number: Rectangle {
        x: host.width - self.width + 6px;
        y: -4px;
        height: size == ControlSize.small || size == ControlSize.xsmall ? 14px : 16px;
        min-width: self.height;
        border-radius: self.height / 2;
        background: color;

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            alignment: center;

            Text {
                text: label;
                color: #ffffff;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}
