---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;

// h1 is the page title, already shown above; anything below h3 turns the
// column into a wall of text on API pages.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const label = 'On this page';
---

<nav class="toc" aria-label={label} hidden={items.length < 2}>
  <p class="toc__label">{label}</p>
  <ul>
    {items.map((h) => (
      <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
        <a href={`#${h.slug}`}>{h.text}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // The API Reference is one heading in the source and two references in the
  // page. Slint's headings are added here, and either set hides while the
  // other framework is selected.
  const list = document.querySelector('.toc ul');
  document.querySelectorAll('.framework-api').forEach((api) => {
    let heading = api.previousElementSibling;
    while (heading && !/^H[2-4]$/.test(heading.tagName)) heading = heading.previousElementSibling;
    let after = heading?.id
      ? list?.querySelector(`a[href="#${CSS.escape(heading.id)}"]`)?.closest('li')
      : undefined;
    api.querySelectorAll<HTMLElement>('[data-framework-panel="slint"] :is(h2, h3, h4)').forEach((node) => {
      if (!list || !node.id || list.querySelector(`a[href="#${CSS.escape(node.id)}"]`)) return;
      const label = node.cloneNode(true) as HTMLElement;
      label.querySelector('.heading-anchor')?.remove();
      const item = document.createElement('li');
      item.className = 'toc__item toc__item--sub';
      const link = document.createElement('a');
      link.href = `#${node.id}`;
      link.dataset.frameworkToc = 'slint';
      link.textContent = label.textContent?.trim() ?? '';
      item.append(link);
      after?.after(item);
      after = item;
    });
  });

  const syncFrameworkToc = () => {
    const framework = document.documentElement.dataset.framework === 'slint' ? 'slint' : 'gpui';
    document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((link) => {
      const item = link.closest('li');
      if (!item) return;
      if (link.dataset.frameworkToc === 'slint') {
        item.hidden = framework !== 'slint';
        if (item.hidden) link.classList.remove('is-current');
        return;
      }
      const id = decodeURIComponent(link.hash.slice(1));
      const panel = document.getElementById(id)?.closest<HTMLElement>('[data-framework-panel]');
      item.hidden = panel ? panel.dataset.frameworkPanel !== framework : false;
      if (item.hidden) link.classList.remove('is-current');
    });
  };
  syncFrameworkToc();
  document.addEventListener('framework-change', syncFrameworkToc);

  // Component pages lead with the install bar and the live example. Neither is
  // a markdown heading, so they are pinned here, above the generated outline.
  const pins = [
    { id: 'framework-bar', text: 'Installation' },
    { id: 'live-example', text: 'Live Example' },
  ];

  function pinOutline() {
    const nav = document.querySelector<HTMLElement>('.toc');
    const list = nav?.querySelector('ul');
    const bar = document.querySelector<HTMLElement>('.doc-content .framework-bar');
    if (!nav || !list || !bar) return;
    if (!bar.id) bar.id = 'framework-bar';
    const example = document.querySelector<HTMLElement>('.component-example');
    if (example && !example.id) example.id = 'live-example';

    for (const pin of pins) {
      if (pin.id === 'live-example' && !example) continue;
      if (!document.getElementById(pin.id)) continue;
      if (list.querySelector(`a[href="#${CSS.escape(pin.id)}"]`)) continue;
      const item = document.createElement('li');
      item.className = 'toc__item toc__item--pin';
      const link = document.createElement('a');
      link.href = `#${pin.id}`;
      link.textContent = pin.text;
      item.append(link);
      const previous = pin.id === 'live-example'
        ? list.querySelector('a[href="#framework-bar"]')?.closest('li')
        : null;
      if (previous) previous.after(item);
      else list.prepend(item);
    }
    nav.hidden = false;
  }

  pinOutline();

  // The example is mounted after this script, into a point just under the bar.
  const content = document.querySelector('.doc-content');
  if (content && !document.querySelector('.component-example')) {
    const arrival = new MutationObserver(() => {
      if (!document.querySelector('.component-example')) return;
      arrival.disconnect();
      pinOutline();
      syncFrameworkToc();
      trackOutline();
    });
    arrival.observe(content, { childList: true, subtree: true });
  }

  // Highlights the section the reader is in. `rootMargin` pulls the observation
  // band up to just under the bar so a heading counts as current once it
  // reaches the top of the reading area, not when it enters the viewport.
  let outlineObserver: IntersectionObserver | undefined;
  function trackOutline() {
    outlineObserver?.disconnect();
    document.querySelectorAll('.toc a.is-current').forEach((link) => {
      link.classList.remove('is-current');
    });
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((a) => {
      links.set(decodeURIComponent(a.hash.slice(1)), a);
    });
    if (links.size === 0) return;

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let current: HTMLAnchorElement | null = null;
    const setCurrent = (id: string | undefined) => {
      const next = id ? links.get(id) ?? null : null;
      if (next?.closest('li')?.hidden) return;
      if (next === current) return;
      current?.classList.remove('is-current');
      next?.classList.add('is-current');
      current = next;
    };

    const seen = new Set<string>();
    outlineObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id);
          else seen.delete(entry.target.id);
        }
        // Document order, so the topmost visible heading wins.
        const first = targets.find((el) => seen.has(el.id));
        if (first) {
          setCurrent(first.id);
          return;
        }
        // Nothing in the band — near the foot of the page, or inside a section
        // longer than the viewport. Fall back to the last heading passed.
        const limit = 88;
        let passed: string | undefined;
        for (const el of targets) {
          if (el.getBoundingClientRect().top <= limit) passed = el.id;
        }
        if (passed) setCurrent(passed);
      },
      // The band starts just under the sticky bar (where an anchored heading
      // comes to rest) and ends part-way down, so the entry that is current is
      // the one the reader is actually reading rather than whatever is last
      // on screen.
      { rootMargin: '-88px 0px -55% 0px', threshold: 0 },
    );

    targets.forEach((el) => outlineObserver?.observe(el));
  }

  trackOutline();
</script>
